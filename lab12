#include<iostream>
#include<iomanip>
using namespace std;
int main()
{
int n,i;
float h, k,A,B,C,Ua, Ub, L,q;
float a[10], b[10],c[10],d[10], al [10], be[10],x[10];
cout<<"Enter the initial and final temparture: \n";
cin>>Ua>>Ub;
cout<<"Enter the length of the rod: \n";
cin>>L;
cout<<"Enter the thermal conductivitty of the rod: \n";
cin>>k;
cout<<"Enter the cross section area: \n";
cin>>A;
cout<<"Enter the no. of nodal points: \n";
cin>>n;
cout<<"Enter the temp of the source: \n";
cin>>q;
h=L/n;
B=(k*A)/h;
C=q*A*h;
for(i=2;i<=n;i++)
{
a[i]=-B;
}
for (i=1;i<n;i++)
{
c[i]=-B;
}
for (i=1;i<=n;i++)
{
if(i==1||i==n)
{
b[i]=3*B;
}
else
{
b[i]=2*B;
}
}
for (i=2;i<n;i++)
{
d[i]=C;
}
d[1]=2*B*Ua+C;
d[n]=2*B*Ub+C;
//solution by tridiagonal
al[1]=b[1];
be [1]=d[1]/b[1];
for (i=2;i<=n;i++)
{
al[i]=b[i]-(a[i]*c[i-1]/al[i-1]);
be[i]=(d[i]-a[i]*be[i-1])/al[i];
}
x[n]=be[n];
for (i=n-1;i>=1;i--)
{
x[i]=be[i]-(c[i]*x[i+1])/al[i];
}
cout<<"THe solution of the sustem is:\n";
for (i=1;i<=n;i++)
{
cout<<fixed<<setprecision (2)<<x[i]<<",";
}
return 0;
    
}
